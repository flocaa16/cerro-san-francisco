ErrorDocument 404 /404.html

Options -MultiViews
RewriteEngine On

# /index.html, /index y /home -> página de inicio (/)
RewriteCond %{THE_REQUEST} \s/+(index(\.html)?|home)/?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /pagina.html -> /pagina (redirige links antiguos)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /pagina/ -> /pagina (sin barra final)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/$ /$1 [R=301,L]

# /pagina -> muestra pagina.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

# La carpeta supabase/ es solo para configurar, no se muestra en la web
RedirectMatch 404 ^/supabase(/|$)
